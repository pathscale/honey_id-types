#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "authEndpoints",
        service_id: 20,
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: false,
                schema: (
                    name: "ApiKeyConnect",
                    code: 200,
                    parameters: [
                        Field(
                            name: "appApiKey",
                            ty: String,
                        ),
                    ],
                    returns: [],
                    stream_response: None,
                    description: "Auth connects to an app, presenting the app API key the app was issued, so the app can accept its callbacks.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "InvalidApiKey", code: "ErrorCode::Unauthorized", message: "Wrong appApiKey", fields: []),
                    ],
                )
                
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "AuthorizedConnect",
                    code: 201,
                    parameters: [
                        Field(
                            name: "accessToken",
                            ty: String,
                        ),
                    ],
                    returns: [],
                    stream_response: None,
                    description: "A user connects to an app with the access token auth issued them.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "InvalidAccessToken", code: "ErrorCode::Unauthorized", message: "Wrong accessToken", fields: []),
                    ],
                )
                
            ),
        ]
    )
)
