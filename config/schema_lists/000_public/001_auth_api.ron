#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "publicAuthApi",
        service_id: 1,
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "Signup",
                    code: 10,
                    parameters: [
                        Field(name: "appPublicId", ty: NanoId(len: 16)),
                        Field(name: "username", ty: String),
                        Field(name: "password", ty: String, description: "Base32-crockford encoded password"),
                    ],
                    returns: [
                        Field(name: "nextStep", ty: EnumRef(name: "LoginNextStep")),
                        Field(name: "accessToken", ty: Optional(String)),
                        Field(name: "encryptionKey", ty: Optional(String)),
                        Field(name: "twoFactorExpiresAt", ty: Optional(Int64)),
                        Field(name: "resendAvailableAt", ty: Optional(Int64)),
                    ],
                    stream_response: None,
                    description: "Frontend initiates a public connection and creates new user account at the same time. Note: This endpoint can be used to init a connection",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "InvalidUsername", code: "ErrorCode::BadRequest", message: "Invalid username", fields: []),
                        EndpointErrorSchema(name: "AppNotFound", code: "ErrorCode::NotFound", message: "App not found", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::Unauthorized", message: "Invalid password", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "RegisterTemporaryUser",
                    code: 31,
                    parameters: [
                        Field(name: "appPublicId", ty: NanoId(len: 16)),
                        Field(name: "username", ty: Optional(String)),
                        Field(name: "password", ty: Optional(String), description: "Base32-crockford encoded password. Generated when omitted."),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                        Field(name: "username", ty: Optional(String)),
                        Field(name: "password", ty: Optional(String)),
                    ],
                    stream_response: None,
                    description: "Creates a temporary user for the app and returns an access token. Missing username or Base32 password are generated by the backend and returned once.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "InvalidUsername", code: "ErrorCode::BadRequest", message: "Invalid username", fields: []),
                        EndpointErrorSchema(name: "UsernameTaken", code: "ErrorCode::Conflict", message: "Username is already taken", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::BadRequest", message: "Invalid password format", fields: []),
                        EndpointErrorSchema(name: "AppNotFound", code: "ErrorCode::NotFound", message: "App not found", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitUsername",
                    code: 12,
                    parameters: [
                        Field(name: "appPublicId", ty: NanoId(len: 16)),
                        Field(name: "username", ty: String),
                        Field(name: "loginRequestId", ty: Optional(String), description: "Optional hosted request identifier bound to this target app; omitted by existing clients"),
                    ],
                    returns: [
                        Field(name: "expiresAt", ty: Int64),
                        Field(name: "telegramRecoveryAvailable", ty: Boolean),
                    ],
                    stream_response: None,
                    description: "Step 1: Frontend initiates a public connection and submits username during auth flow. Returns whether Telegram recovery is available for this user. An optional hosted request must match this app and remain unexpired; omitted trailing loginRequestId preserves existing clients.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AppNotFound", code: "ErrorCode::NotFound", message: "App not found", fields: []),
                        EndpointErrorSchema(name: "UserNotFound", code: "ErrorCode::NotFound", message: "User not found", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                        EndpointErrorSchema(name: "LoginRequestExpired", code: "ErrorCode::Unauthorized", message: "Hosted login request has expired", fields: []),
                        EndpointErrorSchema(name: "LoginRequestMismatch", code: "ErrorCode::Forbidden", message: "Hosted request does not match the target app", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitPassword",
                    code: 13,
                    parameters: [
                        Field(name: "password", ty: String, description: "Base32-crockford encoded password"),
                    ],
                    returns: [
                        Field(name: "nextStep", ty: EnumRef(name: "LoginNextStep")),
                        Field(name: "accessToken", ty: Optional(String)),
                        Field(name: "encryptionKey", ty: Optional(String)),
                        Field(name: "twoFactorExpiresAt", ty: Optional(Int64)),
                        Field(name: "resendAvailableAt", ty: Optional(Int64)),
                    ],
                    stream_response: None,
                    description: "Step 2: Submit the password in the active Honey flow. Return the normal session only after required TOTP and a successful app callback; a pending TOTP step returns no usable session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SubmitPassword", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::Unauthorized", message: "Invalid password", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitAppToken",
                    code: 15,
                    parameters: [
                        Field(name: "token", ty: String, description: "Token from the source app"),
                        Field(name: "appPublicId", ty: NanoId(len: 16), description: "Public ID of the source app"),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                    ],
                    stream_response: None,
                    description: "Validate an existing app token and create a new login session for the target app.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SubmitAppToken", fields: []),
                        EndpointErrorSchema(name: "InvalidAppToken", code: "ErrorCode::Unauthorized", message: "Invalid or expired app token", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitRecoveryCode",
                    code: 16,
                    parameters: [
                        Field(name: "recoveryCode", ty: String, description: "Recovery code in XXXX-XXXX-XXXX-XXXX-XXXX-XXXX Crockford Base32 format"),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                        Field(name: "recoveryCode", ty: String),
                    ],
                    stream_response: None,
                    description: "After username submission, frontend submits a recovery code to bypass password and Telegram recovery. The used code is rotated and a new code is returned once.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SubmitRecoveryCode", fields: []),
                        EndpointErrorSchema(name: "InvalidRecoveryCode", code: "ErrorCode::Unauthorized", message: "Invalid recovery code", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "GenerateRecoveryCode",
                    code: 17,
                    parameters: [],
                    returns: [
                        Field(name: "recoveryCode", ty: String),
                    ],
                    stream_response: None,
                    description: "Generates and stores a new recovery code for the current fully verified auth session. The plaintext code is returned once.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SetPassword",
                    code: 29,
                    parameters: [
                        Field(name: "password", ty: String, description: "Base32-crockford encoded password"),
                    ],
                    returns: [],
                    stream_response: None,
                    description: "Updates password for the current fully verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::Unauthorized", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::BadRequest", message: "Invalid password format", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "ChangeUsername",
                    code: 30,
                    parameters: [
                        Field(name: "username", ty: String),
                    ],
                    returns: [
                        Field(name: "username", ty: String),
                    ],
                    stream_response: None,
                    description: "Updates username for the current fully verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "InvalidUsername", code: "ErrorCode::BadRequest", message: "Invalid username", fields: []),
                        EndpointErrorSchema(name: "UsernameTaken", code: "ErrorCode::Conflict", message: "Username is already taken", fields: []),
                        EndpointErrorSchema(name: "NotFound", code: "ErrorCode::NotFound", message: "User not found", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "GetTelegramRecoveryStatus",
                    code: 18,
                    parameters: [],
                    returns: [
                        Field(name: "enabled", ty: Boolean),
                        Field(name: "telegramUserId", ty: Optional(Int64)),
                        Field(name: "telegramUsername", ty: Optional(String)),
                        Field(name: "boundAt", ty: Optional(Int64)),
                    ],
                    stream_response: None,
                    description: "Returns Telegram recovery binding status for the current credential-verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitTelegramRecoveryCode",
                    code: 19,
                    parameters: [
                        Field(name: "code", ty: String),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                    ],
                    stream_response: None,
                    description: "Completes login through Telegram recovery after username submission.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SubmitTelegramRecoveryCode", fields: []),
                        EndpointErrorSchema(name: "ChallengeMissing", code: "ErrorCode::BadRequest", message: "Telegram recovery challenge missing", fields: []),
                        EndpointErrorSchema(name: "TooManyAttempts", code: "ErrorCode::TooManyRequests", message: "Too many Telegram recovery attempts", fields: []),
                        EndpointErrorSchema(name: "InvalidCode", code: "ErrorCode::Unauthorized", message: "Invalid Telegram recovery code", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SendTelegramRecoveryCode",
                    code: 20,
                    parameters: [],
                    returns: [
                        Field(name: "twoFactorExpiresAt", ty: Int64),
                        Field(name: "resendAvailableAt", ty: Int64),
                    ],
                    stream_response: None,
                    description: "Generates and sends a Telegram recovery challenge for the current auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SendTelegramRecoveryCode", fields: []),
                        EndpointErrorSchema(name: "TelegramNotConfigured", code: "ErrorCode::BadRequest", message: "Telegram recovery is not configured", fields: []),
                        EndpointErrorSchema(name: "ResendCooldown", code: "ErrorCode::TooManyRequests", message: "Telegram recovery resend cooldown is active", fields: []),
                        EndpointErrorSchema(name: "TelegramUnavailable", code: "ErrorCode::ServiceUnavailable", message: "Telegram recovery is unavailable", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "StartTelegramRecoveryEnrollment",
                    code: 21,
                    parameters: [],
                    returns: [
                        Field(name: "botLink", ty: String),
                        Field(name: "expiresAt", ty: Int64),
                    ],
                    stream_response: None,
                    description: "Starts Telegram recovery enrollment for the current credential-verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "TelegramUnavailable", code: "ErrorCode::ServiceUnavailable", message: "Telegram recovery is unavailable", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "ConfirmTelegramRecoveryEnrollment",
                    code: 22,
                    parameters: [
                        Field(name: "code", ty: String),
                    ],
                    returns: [],
                    stream_response: None,
                    description: "Confirms Telegram recovery enrollment after the bot receives the setup link and sends a confirmation code.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "EnrollmentExpired", code: "ErrorCode::RequestTimeout", message: "Telegram recovery enrollment expired", fields: []),
                        EndpointErrorSchema(name: "ConfirmationMissing", code: "ErrorCode::BadRequest", message: "Open the Telegram setup link before confirming enrollment", fields: []),
                        EndpointErrorSchema(name: "TooManyAttempts", code: "ErrorCode::TooManyRequests", message: "Too many Telegram recovery enrollment attempts", fields: []),
                        EndpointErrorSchema(name: "InvalidCode", code: "ErrorCode::Unauthorized", message: "Invalid Telegram recovery enrollment code", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "DisableTelegramRecovery",
                    code: 23,
                    parameters: [],
                    returns: [],
                    stream_response: None,
                    description: "Disables Telegram recovery for the current fully verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitTotpCode",
                    code: 24,
                    parameters: [
                        Field(name: "code", ty: String),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                    ],
                    stream_response: None,
                    description: "Completes password login by verifying a TOTP code from an authenticator app.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "TooManyAttempts", code: "ErrorCode::TooManyRequests", message: "Too many TOTP attempts", fields: []),
                        EndpointErrorSchema(name: "TotpNotConfigured", code: "ErrorCode::BadRequest", message: "TOTP is not configured", fields: []),
                        EndpointErrorSchema(name: "InvalidCode", code: "ErrorCode::Unauthorized", message: "Invalid TOTP code", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "GetTotpStatus",
                    code: 25,
                    parameters: [],
                    returns: [
                        Field(name: "enabled", ty: Boolean),
                        Field(name: "enabledAt", ty: Optional(Int64)),
                        Field(name: "lastVerifiedAt", ty: Optional(Int64)),
                    ],
                    stream_response: None,
                    description: "Returns TOTP binding status for the current fully verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "StartTotpEnrollment",
                    code: 26,
                    parameters: [],
                    returns: [
                        Field(name: "otpauthUri", ty: String),
                        Field(name: "manualSecret", ty: String),
                        Field(name: "expiresAt", ty: Int64),
                    ],
                    stream_response: None,
                    description: "Starts TOTP enrollment and returns an otpauth URI plus manual secret.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "ConfirmTotpEnrollment",
                    code: 27,
                    parameters: [
                        Field(name: "code", ty: String),
                    ],
                    returns: [],
                    stream_response: None,
                    description: "Confirms TOTP enrollment by verifying a code from the authenticator app.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "EnrollmentExpired", code: "ErrorCode::RequestTimeout", message: "TOTP enrollment expired", fields: []),
                        EndpointErrorSchema(name: "TooManyAttempts", code: "ErrorCode::TooManyRequests", message: "Too many TOTP enrollment attempts", fields: []),
                        EndpointErrorSchema(name: "InvalidCode", code: "ErrorCode::Unauthorized", message: "Invalid TOTP code", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "DisableTotp",
                    code: 28,
                    parameters: [],
                    returns: [],
                    stream_response: None,
                    description: "Disables TOTP for the current fully verified auth session.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "DeleteSelf",
                    code: 14,
                    parameters: [],
                    returns: [],
                    stream_response: None,
                    description: "Delete user's own account. Requires completed auth flow.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthNotVerified", code: "ErrorCode::BadRequest", message: "Complete auth flow before continuing", fields: []),
                        EndpointErrorSchema(name: "NotFound", code: "ErrorCode::NotFound", message: "User not found", fields: []),
                    ],
                )

            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "BeginPasskeySignIn",
                    code: 32,
                    parameters: [],
                    returns: [
                        Field(name: "challengeId", ty: String, description: "Opaque single-use challenge identifier bound to this connection and flow"),
                        Field(name: "challengeJson", ty: String, description: "Serialized WebAuthn options for the server-configured RP and exact origin"),
                        Field(name: "expiresAt", ty: Int64, description: "Unix seconds; challenge expires within the five-minute authentication flow"),
                    ],
                    stream_response: None,
                    description: "Begin a Honey passkey assertion for the user and app bound to the active SubmitUsername flow. Require user verification and the configured exact Honey origin.",
                    json_schema: (),
                    roles: ["UserRole::Public"],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "An active SubmitUsername flow is required", fields: []),
                        EndpointErrorSchema(name: "AuthFlowExpired", code: "ErrorCode::Unauthorized", message: "The authentication flow has expired", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                        EndpointErrorSchema(name: "RateLimited", code: "ErrorCode::TooManyRequests", message: "Authentication is temporarily rate limited", fields: []),
                    ],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "VerifyPasskey",
                    code: 33,
                    parameters: [
                        Field(name: "challengeId", ty: String, description: "Challenge returned by BeginPasskeySignIn"),
                        Field(name: "assertionJson", ty: String, description: "Serialized WebAuthn assertion; credential and user handle must match the username flow"),
                    ],
                    returns: [
                        Field(name: "nextStep", ty: EnumRef(name: "LoginNextStep"), description: "complete or totp; outstanding TOTP returns no usable session"),
                        Field(name: "accessToken", ty: Optional(String), description: "Normal Honey UUID access token; absent until required TOTP completes"),
                        Field(name: "encryptionKey", ty: Optional(String), description: "Normal composed app and user encryption key; absent until completion"),
                        Field(name: "twoFactorExpiresAt", ty: Optional(Int64), description: "Unix seconds; expiry of the pending second-factor flow"),
                        Field(name: "resendAvailableAt", ty: Optional(Int64), description: "Unix seconds; next permitted recovery resend when applicable"),
                    ],
                    stream_response: None,
                    description: "Consume the bound single-use passkey assertion and enter normal Honey credential completion, including required TOTP, membership policy and app callback. No session is returned while TOTP is pending.",
                    json_schema: (),
                    roles: ["UserRole::Public"],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "An active SubmitUsername flow is required", fields: []),
                        EndpointErrorSchema(name: "AuthFlowExpired", code: "ErrorCode::Unauthorized", message: "The authentication flow has expired", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                        EndpointErrorSchema(name: "ChallengeExpired", code: "ErrorCode::Unauthorized", message: "The ceremony challenge has expired", fields: []),
                        EndpointErrorSchema(name: "ChallengeConsumed", code: "ErrorCode::Conflict", message: "The ceremony challenge has already been consumed", fields: []),
                        EndpointErrorSchema(name: "ChallengeMismatch", code: "ErrorCode::Unauthorized", message: "The challenge does not match this flow, owner, app or purpose", fields: []),
                        EndpointErrorSchema(name: "InvalidCredential", code: "ErrorCode::Unauthorized", message: "Credential verification failed", fields: []),
                        EndpointErrorSchema(name: "CredentialRevoked", code: "ErrorCode::Unauthorized", message: "The credential has been revoked", fields: []),
                        EndpointErrorSchema(name: "RateLimited", code: "ErrorCode::TooManyRequests", message: "Authentication is temporarily rate limited", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                        EndpointErrorSchema(name: "PersistenceFailed", code: "ErrorCode::InternalError", message: "The required credential write could not be persisted", fields: []),
                    ],
                ),
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "EnrollPasskey",
                    code: 34,
                    parameters: [
                        Field(name: "label", ty: String, description: "User-visible label for this passkey"),
                    ],
                    returns: [
                        Field(name: "challengeId", ty: String, description: "Opaque single-use challenge identifier bound to this connection and flow"),
                        Field(name: "challengeJson", ty: String, description: "Serialized WebAuthn options for the server-configured RP and exact origin"),
                        Field(name: "expiresAt", ty: Int64, description: "Unix seconds; challenge expires within the five-minute authentication flow"),
                    ],
                    stream_response: None,
                    description: "Begin passkey enrolment only after a password submitted in this current five-minute Honey flow and completion of required TOTP. Public role alone, signup and every other credential method are insufficient.",
                    json_schema: (),
                    roles: ["UserRole::Public"],
