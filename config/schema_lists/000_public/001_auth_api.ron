#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

Config(
    definition: EndpointSchemaList(
        service_name: "publicAuthApi",
        service_id: 1,
        endpoints: [
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "Signup",
                    code: 10,
                    parameters: [
                        Field(name: "appPublicId", ty: NanoId(len: 16)),
                        Field(name: "username", ty: String),
                        Field(name: "password", ty: String),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                    ],
                    stream_response: None,
                    description: "Frontend creates new user account.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "InvalidUsername", code: "ErrorCode::BadRequest", message: "Invalid username", fields: []),
                        EndpointErrorSchema(name: "AppNotFound", code: "ErrorCode::NotFound", message: "App not found", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::Unauthorized", message: "Invalid password", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )
                
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitUsername",
                    code: 12,
                    parameters: [
                        Field(name: "appPublicId", ty: NanoId(len: 16)),
                        Field(name: "username", ty: String),
                    ],
                    returns: [
                        Field(name: "expiresAt", ty: Int64),
                    ],
                    stream_response: None,
                    description: "Step 1: Frontend submits username during auth flow.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AppNotFound", code: "ErrorCode::NotFound", message: "App not found", fields: []),
                        EndpointErrorSchema(name: "UserNotFound", code: "ErrorCode::NotFound", message: "User not found", fields: []),
                        EndpointErrorSchema(name: "AccountForbidden", code: "ErrorCode::Forbidden", message: "Account is disabled or banned", fields: []),
                    ],
                )
                
            ),
            EndpointSchemaElement(
                frontend_facing: true,
                schema: (
                    name: "SubmitPassword",
                    code: 13,
                    parameters: [
                        Field(name: "password", ty: String),
                    ],
                    returns: [
                        Field(name: "accessToken", ty: String),
                        Field(name: "encryptionKey", ty: String),
                    ],
                    stream_response: None,
                    description: "Step 2: Frontend submits password to complete HoneyAuth login. Session is per connection. Returns tokens and token metadata.",
                    json_schema: (),
                    roles: [
                        "UserRole::Public",
                    ],
                    errors: [
                        EndpointErrorSchema(name: "AuthFlowRequired", code: "ErrorCode::BadRequest", message: "Call SubmitUsername before SubmitPassword", fields: []),
                        EndpointErrorSchema(name: "InvalidPassword", code: "ErrorCode::Unauthorized", message: "Invalid password", fields: []),
                        EndpointErrorSchema(name: "AccessDenied", code: "ErrorCode::Forbidden", message: "Access denied to this app", fields: []),
                        EndpointErrorSchema(name: "CallbackFailed", code: "ErrorCode::BadGateway", message: "App callback failed", fields: []),
                    ],
                )
                
            ),
        ]
    )
)
